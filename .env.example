# --- Required -----------------------------------------------------------------
# URL users open the site at (used in email links and cookie security).
PUBLIC_URL=http://192.168.0.237:8000
# Comma-separated emails that get admin rights. If empty, the first user to sign in becomes admin.
ADMIN_EMAILS=
# Signs session cookies (min. 16 chars). If empty, a random key is generated and stored in /data/secret_key.
SECRET_KEY=

# SMTP for sign-in codes and alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Hemnet Watch <hemnet@example.com>
# starttls | ssl | none
SMTP_SECURITY=starttls

# --- Optional: tuning (defaults shown) ----------------------------------------
# SCAN_INTERVAL_MINUTES=15     # incremental "published last 24h" scan per region
# FULL_SCAN_HOURS=24           # full scan: price changes + removed listings
# SOLD_SCAN_HOURS=6            # final sale prices
# MAX_PAGES_PER_SCAN=50        # 50 listings per page; Hemnet itself stops at 50 pages
# REQUEST_DELAY_SECONDS=2      # delay between hemnet.se page requests
# ARCHIVE_IMAGES=true
# ARCHIVE_SEED_IMAGES=true     # also archive images of listings found on a region's first scan
# IMAGE_MAX_SIZE=1024          # longest side in px (WebP)
# IMAGE_QUALITY=70
# MIN_FREE_DISK_GB=5           # pause image archiving below this
# TZ=Europe/Stockholm
